NODE_ENV=development
PORT=5011
NOTIFICATIONS_ENABLED=true

# Default marketing admin created by the database seeder
MARKETING_ADMIN_FULL_NAME=Marketing Admin
MARKETING_ADMIN_EMAIL=marketing@smileagric.com
MARKETING_ADMIN_PASSWORD=Marketing@123

# Mailgun email delivery
EMAIL_PROVIDER=mailgun
MAILGUN_USERNAME=api
MAILGUN_API_KEY=key-example
MAILGUN_DOMAIN=mg.example.com
MAILGUN_URL=https://api.mailgun.net
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=SmileAgriMarket

# Links and branding used in email templates
WEBSITE_URL=https://smileagrimarket.com
FE_URL=https://app.smileagrimarket.com
SUPPORT_URL=https://smileagrimarket.com/support
UNSUBSCRIBE_URL=https://smileagrimarket.com/unsubscribe
EMAIL_LOGO_URL=https://smileagrimarket.com/assets/smileagrimarket-wordmark-cropped.png
COMPANY_ADDRESS=SmileAgriMarket

# Paystack investment payments
PAYSTACK_SECRET_KEY=sk_test_example
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://app.smileagrimarket.com/investments/payment/callback
PAYSTACK_TIMEOUT_MS=15000
